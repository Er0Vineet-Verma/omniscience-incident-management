# Copy to docker/.env and fill in real values — compose reads it automatically.
# docker/.env is gitignored; never commit real secrets.

# JWT signing key (Base64, >= 32 bytes decoded). Generate:
#   openssl rand -base64 64
JWT_SECRET=

# MySQL application user password (user "ims", database "imsdb")
DB_PASSWORD=

# MySQL root password (administration only; the app never uses root)
DB_ROOT_PASSWORD=
