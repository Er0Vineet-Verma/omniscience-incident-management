# ── Secrets / environment ────────────────────────────────────────────────
# Never commit real .env files (templates like .env.example are fine)
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# ── Build output ─────────────────────────────────────────────────────────
/backend/target/
/frontend/dist/
/frontend/dist-ssr/

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Local database (runtime H2 files) ────────────────────────────────────
/backend/data/
*.mv.db
*.trace.db

# ── Runtime logs ─────────────────────────────────────────────────────────
# Anchored to runtime output dirs only: never exclude source folders that
# happen to be named "logs" (e.g. backend/src/main/java/com/ims/logs).
/logs/
/backend/logs/
/frontend/logs/
*.log

# ── IDE / OS ─────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
/docs/restore-point/
