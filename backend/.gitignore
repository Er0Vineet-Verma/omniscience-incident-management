# Build output
/target/

# Local database files
/data/

# Runtime log output only — anchored so source packages named "logs"
# (e.g. src/main/java/com/ims/logs) are never excluded.
/logs/
*.log
!src/**/*.log

# Secrets / environment — never commit real .env files
.env
.env.local
.env.*.local

# IDE
.idea/
*.iml
.vscode/
